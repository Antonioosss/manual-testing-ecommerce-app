    {
      "name": "GET - Get Single Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const expectedPostId = Number(\r",
              "    pm.collectionVariables.get(\"postId\")\r",
              ");\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response id matches postId variable\", function (){                \r",
              "    pm.expect(response.id).to.equal(expectedPostId);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains a non-empty title\", function (){           \r",
              "    pm.expect(response).to.have.property(\"title\");\r",
              "    pm.expect(response.title).to.be.a(\"string\");\r",
              "    pm.expect(response.title.trim()).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is below 1000 ms\", function (){ \r",
              "    const responseTime = pm.response.responseTime;\r",
              "    pm.expect(responseTime).to.be.below(1000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET - Get All Posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const responseLength = response.length;\r",
              "const responseFirstElement = response[0];\r",
              "\r",
              "\r",
              "pm.test(\"Received 100 posts\", function () {\r",
              "    pm.expect(responseLength).to.equal(100);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array\", function () {\r",
              "    pm.expect(Array.isArray(response)).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"First element contains title field\", function () {\r",
              "    pm.expect(responseFirstElement).to.have.property(\"title\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains: userId, id, title and body fields\", function () {\r",
              "    response.forEach(post => {\r",
              "        pm.expect(post).to.have.property(\"userId\");\r",
              "        pm.expect(post).to.have.property(\"id\");\r",
              "        pm.expect(post).to.have.property(\"title\");\r",
              "        pm.expect(post).to.have.property(\"body\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Every post contains an integer id\", function () {\r",
              "    response.forEach(post => {\r",
              "        pm.expect(Number.isInteger(post.id)).to.be.true;\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Every userId is between 1 and 10\", function () {\r",
              "    response.forEach(post => {\r",
              "        pm.expect(post.userId).to.be.within(1, 10);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Every title is not empty\", function () {\r",
              "    response.forEach(post => {\r",
              "        pm.expect(post.title).to.not.be.empty;\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Every post has a unique id\", function () {\r",
              "    const ids = response.map(post => post.id);\r",
              "    const uniqueIds = new Set(ids);\r",
              "\r",
              "    pm.expect(uniqueIds.size).to.equal(ids.length);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
