    {
      "name": "PUT - Update Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "const postId = Number(pm.collectionVariables.get(\"postId\"));\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is below 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains required fields\", function () {\r",
              "    pm.expect(response).to.have.property(\"id\");\r",
              "    pm.expect(response).to.have.property(\"title\");\r",
              "    pm.expect(response).to.have.property(\"body\");\r",
              "    pm.expect(response).to.have.property(\"userId\")\r",
              "});\r",
              "\r",
              "pm.test(\"id is an Integer\", function () {\r",
              "    pm.expect(Number.isInteger(response.id)).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"userId is an Integer and within expected range\", function () {\r",
              "    pm.expect(Number.isInteger(response.userId)).to.be.true;\r",
              "    pm.expect(response.userId).to.be.within(1, 10);\r",
              "});\r",
              "\r",
              "pm.test(\"title is String and not empty\", function () {\r",
              "    pm.expect(typeof response.title).to.equal(\"string\");\r",
              "    pm.expect(response.title.trim().length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"body is a String and not empty\", function () {\r",
              "    pm.expect(typeof response.body).to.equal(\"string\");\r",
              "    pm.expect(response.body.trim().length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Response values match request payload\", function () {\r",
              "    pm.expect(response.id).to.equal(postId);\r",
              "    pm.expect(response.title).to.equal(requestBody.title);\r",
              "    pm.expect(response.body).to.equal(requestBody.body);\r",
              "    pm.expect(response.userId).to.equal(requestBody.userId);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
