                  "    pm.expect(response).to.have.property('id');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Returned values match request payload\", function () {\r",
                  "    pm.expect(response.title).to.equal(requestBody.title);\r",
                  "    pm.expect(response.body).to.eql(requestBody.body);\r",
                  "    pm.expect(response.userId).to.eql(requestBody.userId);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Generated id is Integer\", function () {\r",
                  "    pm.expect(Number.isInteger(response.id)).to.be.true;\r",
